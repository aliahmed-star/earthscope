    classDef demo fill:#FDF3DE,stroke:#9A5B00,color:#4A2E00,stroke-width:2px;
    classDef store fill:#E8F1FD,stroke:#2B5E9A,color:#18314F,stroke-width:2px;
    classDef note fill:#FFFFFF,stroke:#8A97A8,color:#3D4757,stroke-dasharray:4 3;
    class START,API,LIVEQ,NORM,LIVE,QUERY,SUM,MODEL,HIST,RULES,INC,RENDER app;
    class NASA nasa;
    class DEMO demo;
    class DB,INGEST store;
    class CARTO note;