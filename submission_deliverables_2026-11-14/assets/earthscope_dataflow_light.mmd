flowchart TB
    START["User selects live, historical, or simulated mode"] --> API["FastAPI · api.py<br/>dashboard, archive, summaries, model APIs"]
    API --> LIVEQ["Live dashboard request<br/>31-day cap · short-lived response cache"]
    LIVEQ --> NASA["NASA POWER Daily point API<br/>T2M · RH2M · WS10M · PRECTOTCORR · UTC"]
    NASA --> NORM["Normalize/validate daily series<br/>wind: m/s × 3.6 → km/h · missing → null"]
    NORM --> LIVE["Live values and prototype threshold labels"]

    INGEST["Retry-safe NASA history ingestion<br/>50 requests · source responses retained"] --> DB["SQLite v2 archive<br/>333,860 daily-variable observations<br/>five cities · four variables<br/>1981-01-01 to 2026-09-14"]
    DB --> QUERY["Historical query by location, variable,<br/>UTC date range and daily resolution"]
    QUERY --> SUM["Deterministic summaries<br/>calculated from plotted points"]
    QUERY --> MODEL["Cairo T2M ridge regression<br/>one-day statistical estimate<br/>chronological test evaluation"]
    QUERY --> HIST["Historical dashboard response"]
    SUM --> HIST
    MODEL --> HIST

    DEMO["Labelled simulated demo data"] --> RULES["Prototype thresholds only<br/>not official warnings or disaster predictions"]
    NORM --> RULES
    RULES --> INC["Prototype incident panel<br/>local demo actions only"]
    LIVE --> RENDER["Browser renders map, table,<br/>four charts, summaries and estimate"]
    INC --> RENDER
    HIST --> RENDER
    CARTO["CARTO tiles<br/>basemap only · not NASA data"] -.-> RENDER

