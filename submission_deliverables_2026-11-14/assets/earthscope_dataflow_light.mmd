flowchart TD
    START["User selects locations and UTC dates"] --> API["FastAPI · api.py<br/>GET /api/dashboard"]
    API --> SVC["dashboard_service.py<br/>31-day cap · parallel requests<br/>10-minute, 128-entry memory cache"]
    SVC -->|Live mode| NASA["NASA POWER Daily point API<br/>T2M · RH2M · WS10M · PRECTOTCORR<br/>UTC · one request per point"]
    SVC -->|Demo mode| DEMO["demo_observations.json<br/>7 simulated rows · not NASA data"]
    SVC -.->|No usable live rows| DEMO
    NASA --> NORM["Normalize NASA records<br/>WS10M: m/s × 3.6 → km/h<br/>fill and missing values → null"]
    NORM --> VALID["Shared validation<br/>schema · ranges · timezone · missingness"]
    DEMO --> VALID
    VALID --> RISK["analysis.py<br/>deterministic prototype-v1 thresholds<br/>not official warnings or forecasts"]
    RISK --> PAY["One JSON dashboard response<br/>aligned dates · missing values stay null"]
    RISK --> INC["IncidentStore<br/>process memory · live and demo separate<br/>PERSIST_INCIDENTS = false"]
    INC --> PAY
    PAY --> RENDER["Browser renders map, table<br/>and four charts"]
    CARTO["CARTO basemap tiles<br/>not NASA data"] -.-> RENDER
    SNAP["Saved NASA JSON snapshots<br/>not read by the live route"] -.-> SVC
    DB["No database or SQL schema<br/>no durable observation store"] -.-> PAY

    classDef app fill:#F4F7FA,stroke:#0B4F6C,color:#1B2433,stroke-width:1px;
    classDef nasa fill:#E4F1EC,stroke:#0F766E,color:#123A34,stroke-width:2px;
    classDef demo fill:#FDF3DE,stroke:#9A5B00,color:#4A2E00,stroke-width:2px;
    classDef note fill:#FFFFFF,stroke:#8A97A8,color:#3D4757,stroke-dasharray:4 3;
    class START,API,SVC,NORM,VALID,RISK,INC,PAY,RENDER app;
    class NASA nasa;
    class DEMO demo;
    class CARTO,SNAP,DB note;
